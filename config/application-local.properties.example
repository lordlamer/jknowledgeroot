# Local, non-committed overrides for development.
# Copy to: config/application-local.properties
# This file is loaded via spring.config.import in application.properties.

# Local server port
KR_SERVER_PORT=8081

# Local app DB connection
KR_DB_URL=jdbc:mariadb://localhost:3306/knowledgeroot?createDatabaseIfNotExist=true&zeroDateTimeBehavior=convertToNull&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Europe/Berlin
KR_DB_USER=root
KR_DB_PASSWORD=change-me-app-db-password

# Local storage settings
KR_STORAGE_DRIVER=minio
KR_FILE_STORAGE_DIR=./storage
KR_MINIO_URL=http://localhost:9000
KR_MINIO_ACCESS_KEY=change-me-minio-access-key
KR_MINIO_SECRET_KEY=change-me-minio-secret-key
KR_MINIO_BUCKET=knowledgeroot

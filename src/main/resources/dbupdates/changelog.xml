                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>
    <changeSet id="1.0.5-jdbc-session" author="knowledgeroot" dbms="mariadb">
        <sqlFile path="changes/1.0.5-jdbc-session.mariadb.sql"
                 relativeToChangelogFile="true" encoding="UTF-8" splitStatements="true" stripComments="true"/>
    </changeSet>
    <changeSet id="1.0.6-initial-setup" author="knowledgeroot" dbms="mariadb">

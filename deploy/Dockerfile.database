FROM mariadb:12.3.3@sha256:99c125f103f5d081ebbc9ffe064e63daf7f688ac33a5f7f29af2d7260a96debf
# The pinned MariaDB digest (17 October 2026) already contains the Ubuntu glibc
# 2.39-0ubuntu8.9, openssl 3.0.13-0ubuntu3.16, Perl and DBI fixes; keep the server
# and its entrypoint intact.
# This deployment uses preinstalled package keyrings and does not invoke GPG.
# Keep gpgv and the installed keyring for APT signature verification.
# Do not autoremove MariaDB's Perl, networking or other runtime dependencies.
RUN apt-get purge -y gpg libsqlite3-0
ARG BUILD_VERSION=1.1.0-SNAPSHOT
ARG BUILD_REVISION=unknown
LABEL org.opencontainers.image.version=$BUILD_VERSION org.opencontainers.image.revision=$BUILD_REVISION

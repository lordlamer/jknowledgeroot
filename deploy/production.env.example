# Copy OUTSIDE the repository and restrict file permissions. Do not use literal placeholders.
KR_APP_IMAGE=lordlamer/knowledgeroot:REPLACE_WITH_RELEASE_TAG_OR_DIGEST
# Use the database image published alongside the application (prefer its digest).
# For snapshot rollback select the database image recorded in the old backup.
KR_DB_IMAGE=lordlamer/knowledgeroot:database-REPLACE_WITH_RELEASE_TAG_OR_DIGEST
KR_DB_ROOT_PASSWORD=
# Generate distinct random URL-safe values of at least 32 characters for these two accounts.
KR_DB_PASSWORD=
KR_MIGRATION_PASSWORD=
KR_BOOTSTRAP_LOGIN=
KR_BOOTSTRAP_PASSWORD=
# Set native ONLY after restricting access to the app port and configuring the exact proxy peer IP regex.
KR_FORWARD_HEADERS_STRATEGY=none
KR_TRUSTED_PROXY_PATTERN=(?!)
KR_APP_PORT=8081

# Include in an existing nginx http {} block. Replace hostname and certificate paths.
server {
    listen 80;
    server_name knowledge.example.org;
    return 308 https://knowledge.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name knowledge.example.org;
    ssl_certificate /etc/letsencrypt/live/knowledge.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/knowledge.example.org/privkey.pem;
    client_max_body_size 100m;
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host knowledge.example.org;
        # Replace client supplied forwarding headers at this single ingress proxy.
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
        # Live collaboration (R63) keeps one WebSocket per open editor; pass the upgrade through.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_upgrade;
    }
}
